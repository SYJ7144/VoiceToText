# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# 세션 쿠키 서명 키 (아무 랜덤 문자열이나 가능: python3 -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=change-me-to-a-random-secret

# 구글 로그인 (https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보)
# 승인된 리디렉션 URI: http://localhost:8000/auth/google/callback (배포 시 실제 도메인 추가)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 로그인 (https://developers.kakao.com → 내 애플리케이션 → 카카오 로그인)
# Redirect URI: http://localhost:8000/auth/kakao/callback (배포 시 실제 도메인 추가)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
